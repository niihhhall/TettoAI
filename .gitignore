.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Node / frontend ────────────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
*.log
build_output.txt

# ── Editor / OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp

# ── Kiro (commit steering + specs; ignore local-only state) ────────────
