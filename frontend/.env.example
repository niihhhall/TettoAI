# CodeVerity Operator Console — frontend env (Vite)

# FastAPI backend base URL (Heroku/Railway in prod, localhost in dev).
VITE_API_URL="http://localhost:8000"

# Optional explicit WebSocket URL. If omitted, it's derived from VITE_API_URL
# (http->ws, https->wss) + /api/v1/ws/inspections.
# VITE_WS_URL="ws://localhost:8000/api/v1/ws/inspections"

# Legacy MarkEye lead views (Overview/Bookings) still read Supabase; optional.
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY=""
