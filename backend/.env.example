# ============================================================
# CodeVerity backend environment (PRD §8). Copy to .env and fill.
# NEVER commit the real .env.
# ============================================================

# --- Core (required from Phase 1) ---
DATABASE_URL="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/main?sslmode=require"
ENV="development"
# Comma-separated allowed CORS origins. Use "*" in dev; set your Vercel URL in prod,
# e.g. "https://codeverity.vercel.app"
CORS_ORIGINS="*"

# --- Twilio WhatsApp (Phase 2) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Content template SIDs (Phase 2 — from content template builder) ---
CONTENT_SID_COMPANY_LIST=""
CONTENT_SID_JOBSITE_LIST=""
CONTENT_SID_LOCATION_CONFIRM=""
CONTENT_SID_PHOTO_QA=""
CONTENT_SID_VOICE_CONFIRM=""

# --- Messaging provider: "twilio" (default) or "meta" (WhatsApp Cloud API test number) ---
MESSAGING_PROVIDER="twilio"

# --- Meta WhatsApp Cloud API (used when MESSAGING_PROVIDER=meta) ---
# From Meta for Developers -> your App -> WhatsApp -> API Setup:
META_ACCESS_TOKEN=""          # temporary 24h token, or a permanent system-user token
META_PHONE_NUMBER_ID=""       # "Phone number ID" of the test/sender number
META_WABA_ID=""               # WhatsApp Business Account ID (optional)
# You invent this string; enter the SAME value in the Meta webhook config "Verify token".
META_VERIFY_TOKEN=""
# App secret (Meta App -> Settings -> Basic) for X-Hub-Signature-256 verification (recommended).
META_APP_SECRET=""
META_GRAPH_VERSION="v22.0"
# Webhook callback URL to register in Meta:  <PUBLIC_BASE_URL>/api/v1/whatsapp/meta

# --- Cloudflare R2 (Phase 3) ---
R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="codeverity-media"
R2_PUBLIC_CUSTOM_DOMAIN="cdn.codeverity.ai"

# --- AI / geocoding (Phase 3) ---
DEEPGRAM_API_KEY=""
FIREWORKS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# --- Modal PDF microservice (Phase 4) ---
MODAL_API_URL="https://your-app.modal.run"

# --- Security (added in production-hardening Phase 1) ---
# Secret for signing operator session JWTs. REQUIRED in production. Generate a long random
# value, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=720
# Public URL Twilio signs webhooks against, e.g. https://api.your-domain.com
# Set behind a proxy (Heroku/Railway) where the internal host differs from the public one.
PUBLIC_BASE_URL=
# Verify X-Twilio-Signature when a Twilio auth token is present (leave true in production).
TWILIO_WEBHOOK_VALIDATE=true
# Exact console origin(s), comma-separated. Do NOT use "*" in production.
CORS_ORIGINS=http://localhost:5173
